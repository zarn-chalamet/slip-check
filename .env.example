# Database
DB_URL=jdbc:postgresql://localhost:5433/slipcheck
DB_USER=postgres
DB_PASSWORD=postgres

# Security
JWT_SECRET=long-random-at-least-32-bytes
ENCRYPTION_KEY_BASE64=32-bytes-base64-encoded==

# Provider (name the chosen provider; keys from its dashboard)
PROVIDER_NAME=mock            # mock | <realProvider>
PROVIDER_API_KEY=
PROVIDER_BASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling         # polling (dev) | webhook (prod)
TELEGRAM_WEBHOOK_SECRET=

# LINE
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_PUSH_ENABLED=false

# App
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173
PORT=8080
